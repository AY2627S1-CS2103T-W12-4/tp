@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedRecruitDexData" as VersionedRecruitDexData MODEL_COLOR
end box

[-> Model : undoRecruitDexData()
activate Model

Model -> VersionedRecruitDexData : undo()
activate VersionedRecruitDexData

VersionedRecruitDexData -> VersionedRecruitDexData :resetData(ReadOnlyRecruitDexData)
VersionedRecruitDexData --> Model :
deactivate VersionedRecruitDexData

[<-- Model
deactivate Model

@enduml
