@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "RecruitDexData Storage" #F4F6F6{
Class JsonRecruitDexDataStorage
Class JsonSerializableRecruitDexData
Class JsonAdaptedApplicant
Class JsonAdaptedTag
Class JsonAdaptedComparisonList
Class JsonAdaptedComparisonDecision
Class JsonAdaptedComparisonPair
}

}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonRecruitDexDataStorage

JsonRecruitDexDataStorage ..> JsonSerializableRecruitDexData
JsonSerializableRecruitDexData --> "*" JsonAdaptedApplicant
JsonAdaptedApplicant --> "*" JsonAdaptedTag
JsonSerializableRecruitDexData --> "1" JsonAdaptedComparisonList
JsonAdaptedComparisonList --> "*" JsonAdaptedComparisonDecision
JsonAdaptedComparisonList --> "0..1" JsonAdaptedComparisonPair

@enduml
