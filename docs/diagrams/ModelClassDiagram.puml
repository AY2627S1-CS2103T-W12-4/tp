@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam nodesep 35
skinparam ranksep 45
skinparam linetype ortho

package Model as ModelPackage <<Rectangle>> {
    class "<<interface>>\nModel" as Model
    class ModelManager
    class RecruitDexData
    class UserPrefs
    class ApplicantRegistry
    class Applicant
    class ComparisonList
    class ComparisonState
    class ComparisonPair
    class ComparisonDecision
    class PairSelector
    class RankingEngine
    class RankingEntry

    ModelManager .up.|> Model
    ModelManager -left-> "1" UserPrefs
    ModelManager -down-> "1" RecruitDexData
    ModelManager -right-> "1" RankingEngine
    RankingEngine -down-> "0..*" RankingEntry

    RecruitDexData *-left-> "1" ApplicantRegistry
    ApplicantRegistry -down-> "0..*" Applicant
    RecruitDexData *-down-> "1" ComparisonList
    ComparisonList -left-> ApplicantRegistry
    ComparisonList -right-> RankingEngine

    ComparisonList *-down-> "1" ComparisonState
    ComparisonState -down-> "0..1" ComparisonPair
    ComparisonList *-right-> "0..*" ComparisonDecision
    ComparisonList *-left-> "1" PairSelector
}
@enduml
