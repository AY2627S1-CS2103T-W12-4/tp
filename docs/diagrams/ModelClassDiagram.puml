@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyRecruitDexData" as ReadOnlyRecruitDexData
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class RecruitDexData
Class ModelManager
Class UserPrefs

Class ApplicantRegistry
Class UniqueApplicantList
Class Applicant
Class Address
Class Email
Class Name
Class Phone
Class Tag

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

RecruitDexData .up.|> ReadOnlyRecruitDexData

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyRecruitDexData
ModelManager -left-> "1" RecruitDexData
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

RecruitDexData *--> "1" UniqueApplicantList
UniqueApplicantList --> "~* all" Applicant
ApplicantRegistry -right-> "0..*" Applicant : registered by ApplicantId

Applicant *--> Name
Applicant *--> Phone
Applicant *--> Email
Applicant *--> Address
Applicant *--> "*" Tag

Applicant -[hidden]up--> I
UniqueApplicantList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

ModelManager --> "~* filtered" Applicant
@enduml
