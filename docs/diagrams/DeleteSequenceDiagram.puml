@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":RecruitDexParser" as RecruitDexParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "registry:ApplicantRegistry" as ApplicantRegistry MODEL_COLOR
end box

[-> LogicManager : execute("delete 1")
activate LogicManager

LogicManager -> RecruitDexParser : parseCommand("delete 1")
activate RecruitDexParser

create DeleteCommandParser
RecruitDexParser -> DeleteCommandParser
activate DeleteCommandParser

DeleteCommandParser --> RecruitDexParser
deactivate DeleteCommandParser

RecruitDexParser -> DeleteCommandParser : parse("1")
activate DeleteCommandParser

create DeleteCommand
DeleteCommandParser -> DeleteCommand
activate DeleteCommand

DeleteCommand --> DeleteCommandParser :
deactivate DeleteCommand

DeleteCommandParser --> RecruitDexParser : d
deactivate DeleteCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteCommandParser -[hidden]-> RecruitDexParser
destroy DeleteCommandParser

RecruitDexParser --> LogicManager : d
deactivate RecruitDexParser

LogicManager -> DeleteCommand : execute(m)
activate DeleteCommand

DeleteCommand -> Model : getFilteredApplicantList()
activate Model

Model --> DeleteCommand : lastShownList
deactivate Model

note right of DeleteCommand
  Validate the displayed index, then resolve
  applicantToDelete = lastShownList.get(0).
  applicantId = applicantToDelete.getId().
end note

DeleteCommand -> Model : getApplicantRegistry()
activate Model

Model --> DeleteCommand : registry
deactivate Model

DeleteCommand -> ApplicantRegistry : delete(applicantId)
activate ApplicantRegistry

ApplicantRegistry --> DeleteCommand
deactivate ApplicantRegistry

create CommandResult
DeleteCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteCommand
deactivate CommandResult

DeleteCommand --> LogicManager : r
deactivate DeleteCommand

[<--LogicManager : r
deactivate LogicManager
@enduml
