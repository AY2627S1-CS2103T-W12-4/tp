<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="ranking-panel" spacing="4">
  <Label text="RANKING" styleClass="ranking-title" />
  <Label fx:id="subtitle" styleClass="ranking-subtitle" />
  <!-- Keep all wrapped lines visible; -Infinity uses the label's preferred height as its minimum. -->
  <Label text="Ties share a rank. Applicant commands use the Applicants list. Use Applicant index for compare-remove. Clear the search with list to index hidden applicants."
         styleClass="ranking-note" wrapText="true" minHeight="-Infinity" />
  <ListView fx:id="rankingListView" styleClass="ranking-list-view" VBox.vgrow="ALWAYS">
    <placeholder>
      <Label text="No applicants in the comparison list." styleClass="ranking-empty-message" wrapText="true" />
    </placeholder>
  </ListView>
  <VBox fx:id="unassessedSection" spacing="4" VBox.vgrow="ALWAYS">
    <Label text="UNASSESSED" styleClass="ranking-title" />
    <Label text="Compare these applicants to include them in the ranking."
           styleClass="ranking-note" wrapText="true" minHeight="-Infinity" />
    <ListView fx:id="unassessedListView" styleClass="ranking-list-view" VBox.vgrow="ALWAYS" />
  </VBox>
</VBox>
